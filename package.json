{
  "name": "smelloff-site",
  "version": "1.0.0",
  "private": true,
  "description": "Smelloff / ODORSTRIKE — smelloff.in",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "thumbnails": "node scripts/thumbnails/build-thumbnails.mjs && node scripts/thumbnails/apply-thumbnails.mjs",
    "thumbnails:build": "node scripts/thumbnails/build-thumbnails.mjs",
    "thumbnails:apply": "node scripts/thumbnails/apply-thumbnails.mjs",
    "thumbnails:check": "node scripts/thumbnails/apply-thumbnails.mjs --check",
    "share": "node scripts/share/apply-share-templates.mjs",
    "share:check": "node scripts/share/apply-share-templates.mjs --check",
    "schema": "node scripts/seo/apply-structured-data.mjs",
    "sitemap": "node scripts/seo/build-sitemap.mjs",
    "sitemap:check": "node scripts/seo/build-sitemap.mjs --check",
    "indexnow": "node scripts/indexnow-ping.mjs",
    "lint": "node -c server.js && node -c api/create-order.js && node -c api/verify-payment.js",
    "start": "node server.js",
    "test": "node --test",
    "verify:live": "node scripts/verify-live-deployment.mjs",
    "optimize:critical": "node scripts/optimize-critical-images.mjs",
    "apply:chrome": "node scripts/apply-chrome.mjs",
    "prepare:public": "node scripts/prepare-public.mjs",
    "build": "node scripts/thumbnails/apply-thumbnails.mjs --check && node scripts/seo/apply-structured-data.mjs --check && node scripts/blog/apply-reader.mjs --check && node scripts/share/apply-share-templates.mjs --check && node scripts/seo/build-sitemap.mjs && node -c server.js && node -c api/create-order.js && node -c api/verify-payment.js && npm run optimize:critical && npm run apply:chrome && node scripts/audit-production.mjs && node scripts/write-build-info.mjs && node scripts/prepare-public.mjs",
    "deploy": "wrangler deploy --config ./wrangler.jsonc --assets ./public"
  },
  "dependencies": {
    "express": "^5.2.1",
    "resend": "^4.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}
