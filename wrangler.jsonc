{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smelloff",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    // Pages go through the Worker so www/http can be 301'd to the apex
    // (src/canonical.js); hashed /assets/* skip it and stay free to serve.
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },
  // Attach the Worker to the whole apex and www. Without this the zone's own
  // DNS record answered most paths and pointed back at Cloudflare (error 1000).
  "routes": [
    { "pattern": "smelloff.in", "custom_domain": true },
    { "pattern": "www.smelloff.in", "custom_domain": true }
  ],
  // Read by api/_email.js and api/send-email.js. Keeps the production-only
  // guards on (no resend.dev sender, no localhost origins). nodejs_compat with
  // a 2025-04-01+ compatibility_date exposes vars on process.env.
  "vars": {
    "APP_ENV": "production"
  },
  // PR builds run `npx wrangler preview`, which refuses to run in CI without
  // this block — that is why "Workers Builds" was red on every PR. Previews
  // don't inherit top-level vars, so APP_ENV is repeated to keep the
  // production email guards on. No secrets, crons or routes reach a Preview.
  "previews": {
    "vars": {
      "APP_ENV": "production"
    }
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/15 * * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
