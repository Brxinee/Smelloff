{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smelloff",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 3 * * *",
      "0 10 * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
