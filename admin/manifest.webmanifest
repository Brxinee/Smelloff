{
  "id": "/admin",
  "name": "Smelloff Admin",
  "short_name": "Smelloff Admin",
  "description": "Orders, customers and alerts for the Smelloff store.",
  "start_url": "/admin#home",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0A0A0A",
  "background_color": "#0A0A0A",
  "lang": "en-IN",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/admin/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Orders to do", "url": "/admin#orders?view=todo", "icons": [{ "src": "/admin/icon-192.png", "sizes": "192x192" }] },
    { "name": "New order", "url": "/admin#orders/new", "icons": [{ "src": "/admin/icon-192.png", "sizes": "192x192" }] }
  ]
}
