# ─────────────────────────────────────────────────────────────
# Smelloff / ODORSTRIKE — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://smelloff.in

# ── Razorpay (Payments) ──────────────────────────────────────
# Key ID is exposed to the client (Checkout). Secret is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase (Auth — lazy loaded, optional) ──────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google Sheets (Order logging) ────────────────────────────
# Option A: Service account (googleapis)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Option B: Apps Script webhook (simpler). If set, used instead of A.
SHEETS_WEBHOOK_URL=

# ── Analytics (gated by cookie consent) ──────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Email (Resend, optional) ─────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Smelloff <orders@smelloff.in>
CONTACT_TO_EMAIL=hello@smelloff.in
